# Required: create a bot with @BotFather and paste its token here
BOT_TOKEN=

# Optional: comma-separated Telegram user IDs
ADMINS=

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Whether to discard queued updates before polling starts
DROP_PENDING_UPDATES=true

# IELTS Prep AI backend integration
IELTS_API_BASE_URL=http://127.0.0.1:8000
# Must exactly match TELEGRAM_BOT_INTERNAL_SECRET in the Django backend .env
IELTS_BOT_INTERNAL_SECRET=generate-a-long-random-secret
